{
  "name": "Review",
  "type": "object",
  "properties": {
    "orderId": {
      "type": "string"
    },
    "customerId": {
      "type": "string"
    },
    "restaurantId": {
      "type": "string"
    },
    "riderId": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "comment": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "RESTAURANT",
        "RIDER"
      ]
    }
  },
  "required": [
    "orderId",
    "rating"
  ]
}